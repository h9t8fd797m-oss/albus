// Copy to Config.xcconfig and fill in. Config.xcconfig is gitignored.
//
// The publishable key is designed to be public — RLS is what protects data,
// not this key. It is still kept out of git so it can be rotated without a
// code change, and so no real project reference is committed.
//
// `$()` breaks up the `//` in the URL: xcconfig treats a bare // as a comment.
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxxxxxxxxxxxxxxxxxxx

// ── CAPTCHA (Cloudflare Turnstile) ───────────────────────────────────────
// LEAVE EMPTY until all three steps below are done together. A site key here
// without the matching secret in Supabase — or a secret in Supabase without a
// key here — rejects every new sign-up.
//
//   1. Create a Turnstile widget at https://dash.cloudflare.com → Turnstile.
//      Set its hostname to whatever you put in TURNSTILE_ORIGIN below.
//   2. Paste the SITE key here, and the SECRET key into
//      Supabase → Authentication → Settings → Bot and Abuse Protection.
//   3. Rebuild. Onboarding presents the challenge before creating the account.
//
// Enabling only one side is the failure mode to avoid — see ios/README.md.
TURNSTILE_SITE_KEY =
TURNSTILE_ORIGIN = https:/$()/albus.app

// ── Signed build ─────────────────────────────────────────────────────────
// YES only once DEVELOPMENT_TEAM is set in project.yml and the app is signed
// — see ios/README.md § "Signing is deliberately unset".
//
// It gates the notification capabilities that need an entitlement, chiefly
// Time Sensitive delivery on overdue and plan-broken warnings. Setting that
// level without the entitlement is *ignored* by iOS rather than rejected, so
// leaving this NO costs nothing and claims nothing.
ALBUS_SIGNED_BUILD = NO
