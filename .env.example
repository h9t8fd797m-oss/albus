# Copy to .env and fill in. .env is gitignored — never commit real values.
# Fetch keys from: Supabase dashboard → Project Settings → API Keys

# ── client-safe (ships inside the iOS app) ────────────────────────────────
# The publishable key is designed to be public. RLS is what protects data,
# not this key. Still kept out of git so it can be rotated independently.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── server-only (Edge Functions) ──────────────────────────────────────────
# NEVER ships to the client. Bypasses RLS entirely. Set via:
#   supabase secrets set --env-file .env
# The SUPABASE_ prefix is reserved by the Edge runtime, so the modern secret
# key uses an Albus-owned environment name. The legacy service-role key remains
# an automatic fallback in deployed functions.
ALBUS_SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Privacy-preserving abuse signals. Generate a long random value; rotating it
# deliberately retires all stored device/network correlations.
ALBUS_SIGNAL_PEPPER=

# RevenueCat sends both values. The first is the configured Authorization
# header; the second verifies the exact raw body and its delivery timestamp.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# Comma-separated RevenueCat app ids whose signed events may grant Albus.
REVENUECAT_APP_IDS=
ALBUS_ALLOW_SANDBOX_PURCHASES=false

# ── model routing (see docs/backend.md) ───────────────────────────────────
MODEL_BREAKDOWN_RUBRIC=claude-sonnet-5
MODEL_BREAKDOWN_GENERIC=claude-haiku-4-5
MODEL_CHAT=claude-sonnet-5
